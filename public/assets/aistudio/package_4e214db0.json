{
  "name": "souq-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Multimodal AI assistant module for SouqAlGhanam 2.0 (server + React client).",
  "type": "module",
  "engines": { "node": ">=20.3" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:ui": "playwright test",
    "build": "vite build",
    "dev:demo": "tsx demo/server.ts",
    "start:demo": "npm run build && tsx demo/server.ts"
  },
  "peerDependencies": {
    "express": "^4.19.0 || ^5.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "express": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
